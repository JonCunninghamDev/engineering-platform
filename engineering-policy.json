{
  "schema_version": "engineering-policy/v1",
  "platform": {
    "repository": "JonCunninghamDev/engineering-platform",
    "version": "v0.1.0",
    "commit": "1b09e08b2f6a771bc6b8e0c5359dfb2b8a5b71db"
  },
  "repository": {
    "policy_id": "engineering-platform",
    "description": "Repository-local policy for the Engineering Platform authoring repository."
  },
  "branches": {
    "release": "main",
    "integration": "develop",
    "temporary_prefixes": ["agent/", "feature/", "fix/"]
  },
  "profiles": ["capability.python"],
  "capabilities": {
    "toolchain": ["runtime.python"],
    "tests": ["test.python"]
  },
  "review": {
    "pull_requests_required": true,
    "required_checks": ["Validate engineering platform"],
    "human_approval_for": [
      "release",
      "security",
      "credentials",
      "destructive_operation",
      "backward_incompatible_change"
    ]
  },
  "delivery": {
    "implementation_target": "integration",
    "release_route": "integration_to_release",
    "direct_release_writes": false,
    "hotfix_route": "integration_first"
  },
  "permissions": {
    "read": {
      "tier": "autonomous",
      "risk": "low",
      "actions": ["repository.read", "issue.read", "test.inspect"]
    },
    "bounded_write": {
      "tier": "bounded",
      "risk": "medium",
      "actions": ["branch.write", "draft.write", "test.write", "issue.write"]
    },
    "consequential_write": {
      "tier": "approval_required",
      "risk": "high",
      "actions": ["release.write", "credential.write", "destructive.write"]
    }
  },
  "protected_paths": [
    ".github/workflows/**",
    ".githooks/**",
    "AGENTS.md",
    "engineering-policy.json",
    "agent/operating-contract-v1.md",
    "schemas/**",
    "profiles/**",
    "standards/fast-feedback-v1.json",
    "scripts/validate-pr-policy.py",
    "scripts/validate-protected-paths.py",
    "scripts/run_fast_feedback.py",
    "scripts/validate_agent_command.py",
    "requirements-dev.txt"
  ],
  "validation": {
    "stages": [
      {
        "id": "python-after-write",
        "stage": "after_write",
        "capability": "test.python",
        "required": false
      },
      {
        "id": "python-pre-commit",
        "stage": "pre_commit",
        "capability": "test.python",
        "required": true
      },
      {
        "id": "python-completion",
        "stage": "completion_gate",
        "capability": "test.python",
        "required": true
      }
    ]
  },
  "execution_budgets": {
    "max_steps": 200,
    "max_elapsed_minutes": 60,
    "max_retries": 2,
    "required_dimensions": ["max_steps", "max_retries"]
  },
  "overrides": [],
  "exceptions": [],
  "compatibility": {
    "policy_schema": "engineering-policy/v1",
    "profile_schema": "repository-profile/v1",
    "minimum_platform_version": "0.1.0"
  }
}
