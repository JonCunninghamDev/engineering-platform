{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joncunningham.dev/schemas/context-manifest-v1.schema.json",
  "title": "Context Manifest v1",
  "type": "object",
  "required": ["schema_version", "run", "agent", "workflow", "goal", "readiness", "normalized_context", "provenance", "questions_for_human", "capabilities", "handoff"],
  "properties": {
    "schema_version": {"const": "context-manifest/v1"},
    "agent": {
      "type": "object",
      "required": ["role", "version", "service_tier", "autonomy", "mode"],
      "properties": {
        "role": {"const": "context"},
        "service_tier": {"enum": ["basic", "managed", "full"]},
        "autonomy": {"enum": ["advisory", "supervised", "policy"]},
        "mode": {"enum": ["demo", "test", "production"]}
      }
    },
    "readiness": {
      "type": "object",
      "required": ["ready_for_orchestration", "missing_required", "missing_recommended", "blocking_conflicts", "nonblocking_conflicts"],
      "properties": {
        "ready_for_orchestration": {"type": "boolean"},
        "missing_required": {"type": "array"},
        "missing_recommended": {"type": "array"},
        "blocking_conflicts": {"type": "array"},
        "nonblocking_conflicts": {"type": "array"},
        "repository_specs_ready": {"type": "boolean"}
      }
    },
    "repository_context": {
      "type": "object",
      "required": ["repository", "manifest", "specs", "spec_readiness", "remediation", "questions_for_human"],
      "properties": {
        "repository": {
          "type": "object",
          "required": ["provider", "identifier", "ref"]
        },
        "manifest": {
          "type": "object",
          "required": ["path", "status"]
        },
        "specs": {"type": "array"},
        "spec_readiness": {
          "type": "object",
          "required": ["ready", "missing", "invalid", "draft"],
          "properties": {
            "ready": {"type": "boolean"},
            "missing": {"type": "array"},
            "invalid": {"type": "array"},
            "draft": {"type": "array"}
          }
        },
        "remediation": {
          "type": "object",
          "required": ["required", "action", "draft_artifacts", "assumptions"]
        },
        "questions_for_human": {"type": "array"}
      }
    },
    "handoff": {
      "type": "object",
      "required": ["target", "artifact", "allowed"]
    }
  }
}
