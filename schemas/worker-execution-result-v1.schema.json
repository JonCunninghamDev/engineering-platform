{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joncunningham.dev/schemas/worker-execution-result-v1.schema.json",
  "title": "Worker Execution Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "executor",
    "repository",
    "actions",
    "changed_paths",
    "verification",
    "budget",
    "security",
    "direct_shared_branch_writes"
  ],
  "properties": {
    "schema_version": {
      "const": "worker-execution-result/v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "provider",
        "execution_id"
      ],
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "execution_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "base_commit",
        "branch",
        "head_commit",
        "commits"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "base_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "head_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "commits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "changed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "exit_code",
          "duration_ms"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "unavailable"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "elapsed_ms",
        "retries",
        "cost_usd"
      ],
      "properties": {
        "steps": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consequential_actions_attempted",
        "consequential_actions_blocked"
      ],
      "properties": {
        "consequential_actions_attempted": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "consequential_actions_blocked": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "direct_shared_branch_writes": {
      "const": 0
    }
  }
}
