{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joncunningham.dev/schemas/context-contract-v1.schema.json",
  "title": "Context Contract v1",
  "type": "object",
  "required": ["schema_version", "workflow", "fields"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "context-contract/v1"},
    "workflow": {"type": "string", "minLength": 1},
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "requirement", "prompt"],
        "additionalProperties": false,
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "requirement": {"enum": ["required", "recommended", "optional"]},
          "prompt": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
