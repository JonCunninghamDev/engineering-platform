{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joncunningham.dev/schemas/builder-task-v1.schema.json",
  "title": "Builder Task v1",
  "type": "object",
  "required": [
    "schema_version",
    "assignment",
    "plan",
    "workflow",
    "goal",
    "scope",
    "changes"
  ],
  "properties": {
    "schema_version": {
      "const": "builder-task/v1"
    },
    "assignment": {
      "type": "object",
      "required": [
        "id",
        "source",
        "allowed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "human",
            "execution-runtime"
          ]
        },
        "allowed": {
          "const": true
        }
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "run_id",
        "capability"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "required": [
        "allowed_paths"
      ],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "protected_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "operation",
          "proposed_content"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "enum": [
              "create",
              "update"
            ]
          },
          "original_content": {
            "type": "string"
          },
          "proposed_content": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "update"
                }
              }
            },
            "then": {
              "required": [
                "original_content"
              ]
            }
          }
        ]
      }
    }
  }
}
