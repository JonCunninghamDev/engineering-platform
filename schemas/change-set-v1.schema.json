{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joncunningham.dev/schemas/change-set-v1.schema.json",
  "title": "Change Set v1",
  "type": "object",
  "required": [
    "schema_version",
    "run",
    "agent",
    "workflow",
    "goal",
    "plan_run_id",
    "task_id",
    "assigned_capability",
    "scope",
    "changes",
    "summary",
    "handoff"
  ],
  "properties": {
    "schema_version": {
      "const": "change-set/v1"
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "created_at"
      ]
    },
    "agent": {
      "type": "object",
      "required": [
        "role",
        "version",
        "service_tier",
        "autonomy",
        "mode"
      ],
      "properties": {
        "role": {
          "const": "builder"
        },
        "service_tier": {
          "enum": [
            "basic",
            "managed",
            "full"
          ]
        },
        "autonomy": {
          "enum": [
            "advisory",
            "supervised",
            "policy"
          ]
        },
        "mode": {
          "enum": [
            "demo",
            "test",
            "production"
          ]
        }
      }
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "plan_run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "assigned_capability": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "path",
          "operation",
          "action",
          "before_sha256",
          "after_sha256",
          "diff"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "enum": [
              "create",
              "update"
            ]
          },
          "action": {
            "const": "WOULD_WRITE"
          },
          "before_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "after_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "diff": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "change_count",
        "proposed_write_count",
        "actual_write_count",
        "create_count",
        "update_count"
      ],
      "properties": {
        "actual_write_count": {
          "const": 0
        }
      }
    },
    "handoff": {
      "type": "object",
      "required": [
        "target",
        "artifact",
        "allowed",
        "execution_status"
      ],
      "properties": {
        "target": {
          "const": "verifier"
        },
        "allowed": {
          "const": true
        },
        "execution_status": {
          "const": "proposed_not_applied"
        }
      }
    }
  }
}
