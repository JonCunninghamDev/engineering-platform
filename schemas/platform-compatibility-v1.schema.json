{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joncunningham.dev/schemas/platform-compatibility-v1.schema.json",
  "title": "Platform Compatibility v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "current_platform_version",
    "versioning",
    "surfaces",
    "deprecations"
  ],
  "properties": {
    "schema_version": {"const": "platform-compatibility/v1"},
    "current_platform_version": {"$ref": "#/$defs/semver"},
    "versioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pre_1_0", "stable"],
      "properties": {
        "pre_1_0": {
          "type": "object",
          "additionalProperties": false,
          "required": ["patch", "minor_breaking_changes"],
          "properties": {
            "patch": {"const": "backward_compatible_only"},
            "minor_breaking_changes": {"const": "migration_required"}
          }
        },
        "stable": {
          "type": "object",
          "additionalProperties": false,
          "required": ["patch", "minor", "major"],
          "properties": {
            "patch": {"const": "backward_compatible_fixes"},
            "minor": {"const": "backward_compatible_additions"},
            "major": {"const": "breaking_changes_allowed"}
          }
        }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/surface"}
    },
    "deprecations": {
      "type": "array",
      "items": {"$ref": "#/$defs/deprecation"}
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "interface_version", "compatibility"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "kind": {"enum": ["contract", "schema", "profile", "workflow", "template"]},
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "interface_version": {"type": "string", "minLength": 1},
        "identifier": {"type": "string", "minLength": 1},
        "compatibility": {
          "enum": [
            "breaking_requires_version_boundary",
            "stable_identifier",
            "stable_public_interface"
          ]
        },
        "public_inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
        },
        "stable_job_names": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "profile"}}},
          "then": {"required": ["identifier"]}
        },
        {
          "if": {"properties": {"kind": {"const": "workflow"}}},
          "then": {"required": ["public_inputs", "stable_job_names"]}
        }
      ]
    },
    "deprecation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "replacement_surface_id",
        "first_deprecated_version",
        "earliest_removal_version",
        "migration_document"
      ],
      "properties": {
        "surface_id": {"type": "string", "minLength": 1},
        "replacement_surface_id": {"type": "string", "minLength": 1},
        "first_deprecated_version": {"$ref": "#/$defs/semver"},
        "earliest_removal_version": {"$ref": "#/$defs/semver"},
        "migration_document": {"type": "string", "minLength": 1}
      }
    }
  }
}
